{
  "name": "lotiq-bridge-app",
  "version": "0.1.0",
  "private": true,
  "main": "expo/AppEntry.js",
  "description": "LotIQ camera-provisioning bridge — React Native (Expo) field app. The bridge core under src/bridge is pure TS (RN + Node compatible); it ports the proven Node reference and is validated against the Baichuan golden fixtures.",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "test": "node --test \"src/bridge/**/*.test.ts\"",
    "typecheck:core": "tsc -p tsconfig.core.json --noEmit"
  },
  "dependencies": {
    "aes-js": "^3.1.2",
    "babel-preset-expo": "~57.0.0",
    "expo": "~57.0.24",
    "expo-asset": "~57.0.18",
    "expo-build-properties": "~57.0.21",
    "expo-dev-client": "~57.0.19",
    "expo-keep-awake": "~57.0.2",
    "expo-network": "~57.0.2",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.23",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-tcp-socket": "^6.4.3",
    "spark-md5": "^3.0.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/aes-js": "^3.1.4",
    "@types/node": "^22.20.3",
    "@types/react": "~19.2.4",
    "@types/spark-md5": "^3.0.5",
    "typescript": "~6.0.3"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "//": "react-native-tcp-socket is old-arch only; we ship with newArchEnabled:false (app.json expo-build-properties), so this metadata warning is expected and handled.",
        "exclude": [
          "react-native-tcp-socket"
        ]
      }
    }
  }
}
